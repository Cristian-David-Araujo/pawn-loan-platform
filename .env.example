# Shared root environment (Docker Compose source of truth)
APP_NAME=Mutuum API
APP_ENV=development
WEB_CLIENT_PORT=5173
API_SERVER_PORT=8000
POSTGRES_PORT=5432

POSTGRES_DB=pawn_loan_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=change_me

# API connection string used by local uvicorn/dev runs (outside Docker)
DATABASE_URL=postgresql+psycopg://your_postgres_user:change_me@localhost:5432/pawn_loan_db

# API connection string used by api-server container inside Docker network
DATABASE_URL_DOCKER=postgresql+psycopg://your_postgres_user:change_me@postgres:5432/pawn_loan_db

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_USERNAME=admin
VITE_API_PASSWORD=change_me

# API security
JWT_SECRET_KEY=change_me_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email (Hostinger Mail API). Both values must be set for mail to leave; an installation
# with neither is supported — the password reset hands the token back in the response
# instead, which is what it did before a mailer existed.
#
# HOSTINGER_MAILBOX_RESOURCE_ID is the `resourceId` of a mailbox the token is authorised
# for, as listed by GET /api/mail/v1/account. It is not a placeholder: "me" is refused with
# a 403 that looks exactly like a bad token.
#
# There is no from-address setting. The Hostinger send request has no `from` field, so the
# sender is whichever mailbox that id names; only the display name is ours to choose.
HOSTINGER_MAIL_API_TOKEN=your_token_here
HOSTINGER_MAILBOX_RESOURCE_ID=your_mailbox_id_here
MAIL_FROM_NAME=Mutuum

# Where the reset link points — the web client, not this API.
FRONTEND_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
ADMIN_ROLE=administrator
DB_INIT_ON_STARTUP=true
DB_SEED_ON_STARTUP=true
DB_SEED_FORCE=false
AUTO_INTEREST_GENERATION_ENABLED=true
AUTO_INTEREST_GENERATION_INTERVAL_MINUTES=1440

# Recurring backups. The schedule itself (frequency, hour, destination, Google Drive account)
# is configured from the admin settings screen and stored in the database; these three are
# deployment facts. BACKUP_LOCAL_DIRECTORY must be a writable path — in Docker it is a named
# volume, so the copies survive the container being recreated.
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_INTERVAL_MINUTES=15
BACKUP_LOCAL_DIRECTORY=/var/backups/pawn-platform
