# Versioned production configuration for the DigitalOcean droplet.
#
# This file is the single source of truth for every production value that is NOT a secret, so
# what the server is running is reviewable in a diff instead of living only inside a file
# someone edited over SSH. `remote_deploy.sh` copies it to `.env.production` on the droplet on
# every deploy and appends the three values that cannot be published — POSTGRES_PASSWORD,
# JWT_SECRET_KEY and ADMIN_PASSWORD, which come from GitHub Secrets — plus the DATABASE_URL it
# composes from them.
#
# NEVER put a secret here: this repository is public. Anything added below is world-readable.
# Editing a value here changes production on the next deploy; `.env.production` on the droplet
# is generated and gets overwritten, so hand-editing it there is lost work.

APP_NAME=Pawn Loan API
APP_ENV=production

# Public hostname Caddy serves and requests the Let's Encrypt certificate for. It must already
# resolve to the droplet (A record -> 68.183.117.210) *before* the deploy that changes it: Caddy
# asks for a certificate for exactly this name, and issuance fails on a name that does not point
# here yet. Changing it needs no image rebuild — see VITE_API_BASE_URL.
DOMAIN=nelsy.mutuum.online

# Where the browser sends its API calls. Relative on purpose: Caddy proxies /api/* to the API
# on the same origin, so the compiled bundle is not tied to a hostname and moving to another
# domain is this file plus DNS, not a rebuild. Read at **build** time by the release workflow
# (Vite inlines it into the bundle), which is why it lives here rather than in a secret.
VITE_API_BASE_URL=/api/v1

# Database. The password and the full DATABASE_URL are appended at deploy time from secrets;
# these two are the other half of that connection string, so they must stay in sync with it.
POSTGRES_DB=pawn_loan_db
POSTGRES_USER=pawn_user

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial admin — used ONLY to create the account on the very first boot. After that the
# password lives in the database and is changed from the users screen, so ADMIN_PASSWORD (a
# secret) goes stale by design and editing it changes nothing.
ADMIN_USERNAME=admin
ADMIN_ROLE=administrator

# Recovery escape hatch, off by default. Turning it on overwrites the stored admin password
# with the ADMIN_PASSWORD secret on the next boot, throwing away whatever the operator had
# set — only for a lockout, and turn it back off in the same day.
ADMIN_PASSWORD_RESET_ON_STARTUP=false

# db-bootstrap runs migrations before the API starts; this keeps the API's own
# `alembic upgrade head` as a self-healing fallback. Seeding stays off: the demo data would
# land in a real portfolio.
DB_INIT_ON_STARTUP=true
DB_SEED_ON_STARTUP=false
DB_SEED_FORCE=false

# Interest generation cycle. Every worker starts a scheduler thread and they arbitrate with a
# PostgreSQL advisory lock, so more workers do not mean more billing runs.
AUTO_INTEREST_GENERATION_ENABLED=true
AUTO_INTEREST_GENERATION_INTERVAL_MINUTES=1440

# Recurring backups. What is scheduled — frequency, hour, destination, the Google Drive
# account — is set from the admin settings screen and lives in the database, so it is not
# here: it is business configuration the operator changes without a deploy. These three are
# deployment facts. The interval is how often the thread looks at the clock, which is also the
# schedule's precision. The directory is the mount point of the `backup_data` volume; a copy
# written anywhere else inside the container is discarded by the next deploy.
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_INTERVAL_MINUTES=15
BACKUP_LOCAL_DIRECTORY=/var/backups/pawn-platform
