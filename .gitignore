# ==============================
# Environment and secrets
# ==============================
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Production configuration is versioned, but only its non-secret half: this file holds no
# credentials (see the header in it) and the droplet's generated `.env.production` — which does
# hold them — stays ignored by the rules above.
!deploy/digitalocean/production.env

# Secret files and private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.kdb
*.kdbx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Secret/config backups
*.secret
*.secrets
*.credentials
*.bak
*.backup
*.old

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/

# Packaging artifacts (regenerated by `pip install -e .`)
*.egg-info/
*.egg
.eggs/
build/
sdist/
pip-wheel-metadata/
.tox/
.nox/

# ==============================
# Node / Frontend
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.parcel-cache/
.next/
.nuxt/
dist/
coverage/
*.tsbuildinfo
.vite/
vite.config.*.timestamp-*
.eslintcache

# ==============================
# IDE / OS
# ==============================
.vscode/*
!.vscode/extensions.json
.idea/
.history/
*.code-workspace

# Per developer agent settings (shared skills under .agents/ stay versioned)
.claude/settings.local.json

.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Merge and patch leftovers
*.orig
*.rej

# ==============================
# Docker / infra / runtime
# ==============================
*.log
logs/
*.pid
*.seed
*.pid.lock

# Local runtime and temp data
tmp/
temp/
.cache/

# Database local volumes/backups
postgres_data/
database/backups/
*.dump
*.sqlite3
*.sqlite
*.db
*.db-journal
*.sql.gz
backup-*.sql
dump-*.sql

# Platform data exports. These archives hold the full customer, loan and payment
# history plus user password hashes, so they must never reach the repository.
*-export-*.zip

# Local database dumps: customer data, never commit.
.backups/
